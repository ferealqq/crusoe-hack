# Run `scripts/setup.sh`: it copies this file to .env and fills in the Neon, Crusoe and Modal
# values for your personal Neon branch. Edit by hand only for overrides.

# --- Neon Postgres (written by `neon env pull`) ---
# Pooled URL for the app; direct URL for Alembic migrations. sslmode params are handled in code.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# --- Neon Object Storage (S3 compatible): NOT needed for Shared Brain experiments ---
# They keep all files locally under DATA_DIR. Only the old prompt-grading endpoints use these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# S3_BUCKET=artifacts

# --- Crusoe Intelligence Foundry (OpenAI-compatible) ---
# Console -> Intelligence Foundry -> API Keys. Keys can contain `$`: never double-quote them in a shell.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model IDs are case-sensitive; copy them from GET /playground/models (= /v1/models).
CRUSOE_DEFAULT_MODEL=deepseek-ai/Deepseek-V4-Flash
# Model used to grade outputs (LLM-as-judge)
CRUSOE_JUDGE_MODEL=openai/gpt-oss-120b

# --- Modal (sandboxes) ---
# `uv run modal token new` writes ~/.modal.toml (the setup script does this). For CI, set these instead:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Overrides the environment of the active ~/.modal.toml profile (Modal's default is main)
MODAL_ENVIRONMENT=
MODAL_APP_NAME=crusoe-hack-sandboxes
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=4096
# Sandboxes running at once across all setups
SANDBOX_MAX_CONCURRENCY=24

# --- Shared Brain research ---
RESEARCHER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
CURATOR_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Requests per minute per model: 30 without a Crusoe payment method, 600 with one
CRUSOE_MAX_RPM=30
# You.com Search API key (you.com/platform). Researchers get web_search only when set.
YDC_API_KEY=
# Prepared datasets and research results (git-ignored)
DATA_DIR=data
