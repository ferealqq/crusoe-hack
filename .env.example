# Copy to .env and paste your Crusoe key and Modal token.

# Console -> Intelligence Foundry -> API Keys. Keys can contain `$`: never double-quote them in a shell.
CRUSOE_API_KEY=

# Modal dashboard -> Settings -> API Tokens. These win over ~/.modal.toml, so sandboxes run in
# this project's workspace. Leave empty to use the active ~/.modal.toml profile instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Max seconds for one sandbox run
SANDBOX_TIMEOUT_SECONDS=120
